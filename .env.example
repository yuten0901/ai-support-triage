API_KEY=replace-me
DATABASE_URL=sqlite+pysqlite:///./local.sqlite3

# Multi-tenant mode replaces API_KEY and requires one isolated knowledge/data
# directory per tenant. Values are JSON because pydantic-settings parses maps
# before application startup.
# TENANT_API_KEYS={"acme":"replace-acme","globex":"replace-globex"}
# TENANT_KNOWLEDGE_DIRS={"acme":"knowledge/acme","globex":"knowledge/globex"}
# TENANT_DATA_DIRS={"acme":"data/acme","globex":"data/globex"}
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5
# Optional measured hybrid mode. BM25 remains the zero-service default.
# RETRIEVAL_MODE=hybrid
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL=all-minilm
# SEMANTIC_MIN_SCORE=0.20
# HYBRID_SEMANTIC_GATE=true
# ANTHROPIC_API_KEY=
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/triage
